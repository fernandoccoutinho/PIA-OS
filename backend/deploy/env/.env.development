# =============================================================================
# Overlay — ambiente de desenvolvimento (Módulo 2.11)
# Combinar com backend/.env.example — não é um arquivo de configuração completo.
# =============================================================================

ENVIRONMENT=development
DEBUG=true

# Placeholder — nunca um segredo real. Gerar um valor de verdade antes de
