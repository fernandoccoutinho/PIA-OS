SECRET_KEY=change-me-in-dev
DB_PASSWORD=change-me-in-dev

LOG_LEVEL=DEBUG
LOG_FORMAT=console

TRUSTED_HOSTS=*
CORS_ALLOWED_ORIGINS=*
