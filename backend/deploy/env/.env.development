# deploy/env/.env.development
#
# Overlay de desenvolvimento — só os valores que DIFEREM do default em
# `backend/.env.example`. Sem segredos reais (os defaults de dev já são
# públicos/óbvios de propósito). Ver deploy/env/.env.example para o
# fluxo de uso.

ENVIRONMENT=development
DEBUG=true

LOG_FORMAT=text
LOG_LEVEL=DEBUG

TRUSTED_HOSTS=*
CORS_ALLOWED_ORIGINS=*

RATE_LIMIT_ENABLED=false
