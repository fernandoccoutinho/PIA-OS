# deploy/env/.env.production
#
# Overlay de produção — só os valores que DIFEREM do default. Os
# placeholders de segredo abaixo (SECRET_KEY, DB_PASSWORD) DEVEM ser
# substituídos por valores reais antes do deploy — o `validate_environment`
# do Módulo 2.2 já recusa subir em produção com o valor padrão
# `change-me-in-env`, então esquecer de trocar falha rápido e alto, não
# silenciosamente.

ENVIRONMENT=production
DEBUG=false

# Troque por um valor real — nunca o default. Gere com, por exemplo:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-por-um-valor-real-antes-do-deploy

LOG_FORMAT=json
LOG_LEVEL=INFO

# Nunca "*" em produção — liste os hosts/origens reais.
TRUSTED_HOSTS=api.seu-dominio.com
CORS_ALLOWED_ORIGINS=https://app.seu-dominio.com
CORS_ALLOW_CREDENTIALS=false

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Credenciais do banco — troque por valores reais (usadas também pelo
# serviço `db` do docker-compose.prod.yml, que já falha explicitamente
# no startup se DB_PASSWORD não estiver definida — ver o `:?` no compose).
DB_USER=pia_user
DB_PASSWORD=troque-por-uma-senha-real
DB_NAME=pia_os
