# =============================================================================
# Overlay — ambiente de produção (Módulo 2.11)
# Combinar com backend/.env.example — não é um arquivo de configuração completo.
#
# TRUSTED_HOSTS e CORS_ALLOWED_ORIGINS deliberadamente NÃO ficam como "*"
# aqui — defina a lista explícita real antes do deploy.
# =============================================================================

ENVIRONMENT=production
DEBUG=false

# Placeholders — NUNCA um segredo real neste arquivo versionado.
# Gerar o valor real com:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=troque-por-secrets.token_urlsafe-antes-do-deploy
DB_PASSWORD=troque-por-um-segredo-real-antes-do-deploy

LOG_LEVEL=INFO
LOG_FORMAT=json

# Defina a lista real de hosts/origens confiáveis (sem "*"):
TRUSTED_HOSTS=example.com,www.example.com
CORS_ALLOWED_ORIGINS=https://example.com
