# deploy/env/.env.test
#
# Overlay de teste — só os valores que DIFEREM do default. Espelha o
# que docker-compose.test.yml já injeta via `environment:` diretamente
# (este arquivo é para rodar a suíte FORA do Compose de teste, ex.: um
# runner de CI que só tem um Postgres efêmero disponível via serviço).

ENVIRONMENT=testing
DEBUG=false

SECRET_KEY=test-secret-key-not-for-production

LOG_FORMAT=json
LOG_LEVEL=WARNING

RATE_LIMIT_ENABLED=false
