<mxfile host="app.diagrams.net">
  <diagram name="Fluxo de Requisicao" id="request_flow">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c" value="Cliente" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="110" width="110" height="50" as="geometry" /></mxCell>
        <mxCell id="mw" value="Middlewares&#10;(CORS, RequestID, Security, Timing, Logging)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;" vertex="1" parent="1"><mxGeometry x="180" y="100" width="220" height="70" as="geometry" /></mxCell>
        <mxCell id="ep" value="Endpoint (routers/*)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;" vertex="1" parent="1"><mxGeometry x="450" y="110" width="160" height="50" as="geometry" /></mxCell>
        <mxCell id="hand" value="Handler Global (2.7)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;" vertex="1" parent="1"><mxGeometry x="450" y="200" width="160" height="50" as="geometry" /></mxCell>
        <mxCell id="lgr" value="Logger Central (2.6)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;" vertex="1" parent="1"><mxGeometry x="670" y="155" width="160" height="50" as="geometry" /></mxCell>
        <mxCell id="resp" value="Resposta&#10;(2xx ou envelope de erro)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="900" y="110" width="180" height="50" as="geometry" /></mxCell>
        <mxCell id="e1" edge="1" parent="1" source="c" target="mw" style="html=1;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" edge="1" parent="1" source="mw" target="ep" style="html=1;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="excecao" edge="1" parent="1" source="ep" target="hand" style="html=1;dashed=1;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" edge="1" parent="1" source="ep" target="lgr" style="html=1;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" edge="1" parent="1" source="hand" target="lgr" style="html=1;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" edge="1" parent="1" source="ep" target="resp" style="html=1;"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" edge="1" parent="1" source="hand" target="resp" style="html=1;"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
