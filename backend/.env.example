# =============================================================================
# PIA-OS Backend — variáveis de ambiente
#
# Copie para .env (desenvolvimento) ou .env.<ambiente> (.env.testing,
# .env.staging, .env.production) — ver app/config/loader.py para a ordem
# de resolução. Nunca commitar .env real com segredos.
# =============================================================================

# --- Aplicação ---
APP_NAME=PIA-OS Backend
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

# --- Banco de dados ---
# Opção A (recomendada, usada pela Entrega 2.1): URL completa.
DATABASE_URL=postgresql+psycopg://pia_user:pia_password@db:5432/pia_os

# Opção B: partes discretas — usadas para montar DATABASE_URL automaticamente
# somente se DATABASE_URL não estiver definida. Defina um conjunto OU outro,
# não os dois (se ambos estiverem presentes, DATABASE_URL prevalece).
# DB_HOST=db
# DB_PORT=5432
# DB_NAME=pia_os
# DB_USER=pia_user
# DB_PASSWORD=pia_password

DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_RECYCLE=1800
DATABASE_POOL_TIMEOUT=30
DATABASE_ECHO=false

# --- Segurança (placeholders — sem autenticação implementada nesta etapa) ---
SECRET_KEY=change-me-in-env
JWT_ALGORITHM=HS256
JWT_EXPIRATION=30

# --- Docker ---
DOCKER_ENV=false

# --- Logs ---
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_DESTINATION=console
# LOG_FILE_PATH=logs/app.log
LOG_ROTATION_MAX_BYTES=10485760
LOG_ROTATION_BACKUP_COUNT=5

# --- API ---
API_PREFIX=/api/v1
API_VERSION=v1

# --- CORS ---
CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=*
CORS_ALLOW_CREDENTIALS=false

# --- Trusted Hosts ---
# "*" só em desenvolvimento — em produção, defina uma lista explícita.
TRUSTED_HOSTS=*

# --- Rate Limiting (estrutura — sem Redis nesta etapa) ---
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# --- Validação de Requisição ---
MAX_REQUEST_SIZE_BYTES=10485760
ALLOWED_CONTENT_TYPES=application/json,application/x-www-form-urlencoded

# --- CSP (estrutura apenas — sem política definitiva) ---
# CSP_POLICY=default-src 'self'
