# Copie este arquivo para `.env` e ajuste conforme necessário.
# Todas as variáveis usam o prefixo PIA_.

# Ambiente: development | test | production
PIA_ENVIRONMENT=development
PIA_DEBUG=true

# Servidor HTTP
PIA_HOST=0.0.0.0
PIA_PORT=8000

# Banco de dados (usado a partir da Entrega 2)
# Em docker-compose o host é "db"; localmente use "localhost".
PIA_DATABASE_URL=postgresql+psycopg://pia:pia@localhost:5432/pia_os
